# Copy to .env and fill in. Never commit .env.
# Read by the server (`node server/index.js`), `npm run cli`, `npm run migrate`
# and `npm run backup`. See docs/running-locally.md.

# Postgres connection string. The default matches docker-compose.yml; a
# Homebrew postgresql@16 works the same way once the role and database exist.
DATABASE_URL=postgres://bunvelope:bunvelope@localhost:5432/bunvelope

# OPTIONAL — Postgres TLS. One rule for the server, CLI and backup script:
#   1. an explicit `sslmode=` in DATABASE_URL wins;
#   2. PGSSL=disable → no TLS; PGSSL=verify → TLS, certificate verified;
#      PGSSL=no-verify → TLS, certificate NOT verified (the CLI warns);
#   3. otherwise a local host (localhost, 127.0.0.1, ::1, a unix socket, or no
#      host) → no TLS, and any other host → TLS with certificate verification.
# So leave it unset for a local database. Set PGSSL=no-verify only for a
# remote database with a self-signed certificate you cannot install.
# PGSSL=

# 64+ random bytes (e.g. `openssl rand -hex 48`). Rotates all sessions.
SESSION_SECRET=change-me-to-a-64-char-random-string

# Google OAuth client (console.cloud.google.com → APIs & Services →
# Credentials → Create OAuth client ID → type "Web application").
# Not needed with BYPASS_GOOGLE=true below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Must match the "Authorized redirect URI" on the Google OAuth client.
OAUTH_CALLBACK_URL=http://localhost:3000/auth/google/callback

# OPTIONAL — Google sign-in allowlist: comma-separated addresses. Unset means
# any Google account may sign up (the server logs a warning at boot).
# ALLOWED_EMAILS=you@example.com

# OPTIONAL — per-user budget cap (positive integer). Default 50.
# MAX_BUDGETS_PER_USER=50

# Leave "development" when serving plain http://localhost: "production" marks
# the session cookie Secure, which a browser only sends over HTTPS.
NODE_ENV=development

# OPTIONAL — only behind a TLS-terminating reverse proxy: the number of proxy
# hops to trust for X-Forwarded-For/-Proto (usually 1). Unset trusts none,
# which is right when clients connect to the server directly.
# TRUST_PROXY=1

# OPTIONAL — Postgres pool sizing. Defaults: max 10 connections, 30s idle
# timeout, 10s connect timeout. The server, CLI and backup each open their
# own pool, so keep their sum under the database's max_connections.
# PGPOOL_MAX=10
# PGPOOL_IDLE_TIMEOUT_MS=30000
# PGPOOL_CONNECT_TIMEOUT_MS=10000

# OPTIONAL — skip the boot-time migration run (then run `npm run migrate`
# yourself before starting the server).
# SKIP_MIGRATIONS=1

PORT=3000

# OPTIONAL — `npm run backup`: where to write budget backups (keep it outside
# the repo) and how many files to keep per budget. See docs/backups.md.
# BACKUP_DIR=~/Bunvelope-backups
# BACKUP_KEEP=30

# Maximum authenticated budget request size in MiB (default 64). Saves include
# financial history; encrypted budgets also have base64 overhead. Restart after
# changing this. AI and price-fetch limits remain separate.
# BUDGET_BODY_LIMIT_MB=64

# AI features need no server key: each user enters their own Anthropic API
# key in Settings → AI (bring-your-own-key). The models are fixed in
# js/ai/intents.js and the server clamps to them whatever the client sends.

# OPTIONAL — at-rest encryption for per-user API keys (AES-256-GCM).
# Generate with `openssl rand -base64 32`. Unset stores them unencrypted.
# BUNVELOPE_SECRETS_KEY=

# OPTIONAL — disable Google OAuth and gate access with a shared password.
# When BYPASS_GOOGLE=true the server skips Google strategy registration
# and refuses to start unless BYPASS_PASSWORD is also set. All authenticated
# users share one "bypass" identity in the database (google_sub='bypass:local').
#
# Length policy: 16+ characters recommended. The server still boots with a
# shorter value (just a console warning), but users will be forced to set a
# new 16+ char password on first login. The new value is hashed (scrypt) and
# stored on the bypass user row; once set, this env var is no longer
# consulted for compares. To "factory reset" back to env-var compares:
#   update users set bypass_password_hash = null where google_sub='bypass:local';
#
# Both vars are read once at boot — changing them requires a server restart.
# BYPASS_GOOGLE=false
# BYPASS_PASSWORD=
